{
  "name": "benday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "a dithered tensorpunk client for bluesky",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check:assertions": "node scripts/check-assertions.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quality": "node --test scripts/*.test.mjs",
    "check": "pnpm lint && pnpm check:assertions && pnpm test:quality && pnpm test && pnpm test:browser && pnpm build",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@atproto/api": "0.29.6",
    "@atproto/oauth-client-browser": "0.5.11",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@tanstack/react-query": "5.105.0",
    "hls.js": "^1.7.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@biomejs/biome": "2.6.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
